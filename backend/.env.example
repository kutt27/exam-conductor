PROJECT_NAME="Intelligent Exam Software"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-key-change-this-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase PostgreSQL connection string (direct or pooler)
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or for local development/sqlite fallback: sqlite+aiosqlite:///./exam.db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"

# Groq API Configuration
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"
